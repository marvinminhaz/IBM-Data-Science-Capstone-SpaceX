for row in launch_sites_df.itertuples():
    # Outer radius ring (1000m)
    folium.Circle(
        location=[row.Lat, row.Long],
        radius=1000,
        color=theme_color,
        weight=1.5,
        fill=True,
        fill_color=theme_color,
        fill_opacity=0.15,
        popup=folium.Popup(row.Launch_Site, parse_html=True)
    ).add_to(site_map)

    # Center focal point (small dot so the location is pinpointed)
    folium.CircleMarker(
        location=[row.Lat, row.Long],
        radius=4,
        color="#ffffff",
        fill=True,
        fill_color=theme_color,
        fill_opacity=1.0,
        weight=1.5
    ).add_to(site_map)

    # Styled Label Marker
    label_html = f"""
    <div style="
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.5px;
        color: {theme_color};
        background: {bg_badge};
        border: 1px solid {theme_color}44;
        border-radius: 4px;
        padding: 2px 7px;
        white-space: nowrap;
        box-shadow: 0 2px 6px rgba(0,0,0,0.6);
        pointer-events: none;
    ">
        {row.Launch_Site}
    </div>
    """

    folium.Marker(
        location=[row.Lat, row.Long],
        icon=DivIcon(
            icon_size=(150, 24),    # Explicit bounding box prevents truncation
            icon_anchor=(-10, 12),  # Offsets label 10px to the right and vertically centered
            html=label_html,
        )
    ).add_to(site_map)

